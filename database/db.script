CREATE MEMORY TABLE PUBLIC.AL_DB_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),USAGE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.MEDICAL_STAFF(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TAG_ID INTEGER,TYPE VARCHAR(16777216),X1 DOUBLE,Y1 DOUBLE,IS_HUMAN BOOLEAN DEFAULT FALSE)
ALTER TABLE PUBLIC.MEDICAL_STAFF ALTER COLUMN AL_ID RESTART WITH 62
CREATE MEMORY TABLE PUBLIC.MOVES(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TAG_ID DOUBLE,TIME TIMESTAMP,COLOR VARCHAR(16777216),TYPE VARCHAR(16777216),X1 DOUBLE,Y1 DOUBLE)
ALTER TABLE PUBLIC.MOVES ALTER COLUMN AL_ID RESTART WITH 104925
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
